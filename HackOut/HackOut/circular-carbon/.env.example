# Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/circular_carbon
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/circular_carbon

# RAG & LLM Service Configuration
RAG_SERVICE_URL=http://rag-service:8000/api/recommend
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend & CORS Configuration
PORT=8080
# Set to 'never' in production after first boot if needed, or leave 'always' as data.sql is idempotent
SPRING_SQL_INIT_MODE=always
# Use wildcard '*' or comma-separated actual domain names in production (e.g., https://myapp.onrender.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost:8081,http://frontend:80

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
